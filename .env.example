# ============================================================
# AI 派蒙服务 配置模板
# 复制为 .env 后填写。所有密钥只走环境变量，禁止提交真实值。
# ============================================================

# ---------- 服务 ----------
AI_SERVER_HOST=127.0.0.1
AI_SERVER_PORT=8090

# 校验主服务发来的 X-AI-Key。
# 必须独立生成，禁止复用主服务的 JWT 密钥或 X-Admin-Key。
# 留空时服务拒绝启动（除非显式打开 ALLOW_INSECURE_DEV）。
AI_SERVICE_KEY=
ALLOW_INSECURE_DEV=false

# ---------- 日志 ----------
AI_LOG_LEVEL=INFO
AI_LOG_JSON=true

# ---------- DeepSeek ----------
# ⚠️ 真实密钥只能写进 .env（已被 .gitignore 排除）。
# 本文件是模板、会提交到仓库，这一行必须永远保持为空。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 官方模型 ID（DeepSeek-V4.1-Flash）
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=55
LLM_MAX_RETRIES=1
LLM_MAX_CONCURRENCY=32
# 默认推理档位：chat（关闭思考，语气可调） / analysis（开启思考，适合养成分析）
LLM_DEFAULT_PROFILE=chat

# ---------- 上下文预算（tokens） ----------
HISTORY_BUDGET_TOKENS=6000
SYSTEM_BUDGET_TOKENS=3000
PLAYER_CONTEXT_BUDGET_TOKENS=1500

# ---------- 入参防护 ----------
MAX_PROMPT_CHARS=4000
MAX_HISTORY_MESSAGES=40

# ---------- 提示词来源 ----------
# file = 本地 JSON（开发默认，@see prompts/paimon.json）
# http = 调主服务内部只读接口（生产推荐，保持 AI 服务不碰业务库）
PROMPT_STORE_MODE=file
PROMPT_STORE_FILE=prompts/paimon.json
PROMPT_STORE_URL=http://127.0.0.1:8080
# mode=http 时用于调用主服务内部接口，主服务侧校验 X-Internal-Key
PROMPT_STORE_KEY=
PROMPT_STORE_TIMEOUT_SECONDS=3
PROMPT_STORE_CACHE_TTL=60

# ---------- CORS（留空则关闭，AI 服务不应被前端直连） ----------
CORS_ORIGINS=
