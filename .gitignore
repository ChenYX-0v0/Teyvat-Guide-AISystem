# ============================================================
# 密钥 / 凭据 —— 绝对不能提交（最重要的一组规则，不要动）
# ============================================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks

# ============================================================
# Python 运行产物
# ============================================================
__pycache__/
*.py[cod]
*$py.class
__pypackages__/

# 打包 / 构建产物
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
MANIFEST

# ============================================================
# 虚拟环境（用 pyproject.toml 重建即可，不入库）
# ============================================================
.venv/
venv/
env/
ENV/

# ============================================================
# 测试与代码质量工具缓存
# ============================================================
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ============================================================
# 日志与临时输出
# ============================================================
*.log
logs/
*.out.txt
*.err.txt
smoke*.txt

# ============================================================
# P2 向量库本地数据（可由语料重建，不入库）
# ============================================================
.chroma/
data/vectors/
embeddings_cache/
*.faiss

# ============================================================
# 编辑器 / 操作系统
# ============================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# 以下文件必须入库，不要加进本文件（清单，不是规则）
# ------------------------------------------------------------
#   .env.example              配置模板（只有键名，无密钥）
#   pyproject.toml            依赖定义
#   Dockerfile                镜像构建
#   docker-compose.yml        编排
#   .dockerignore             镜像构建上下文过滤
#   README.md                 项目说明
#   AGENTS.md                 AI 协作规范
#   app/                      服务源码
#   db/migrations/            SQL 建表脚本
#   prompts/                  开发默认提示词
#   tests/                    测试（含验收依据）
#   （注：doc/ 与 shared-docs/ 不在本仓，见下面「共享文档仓链接」）
# ============================================================

# ============================================================
# 共享文档仓链接（Junction，内容在 teyvat-docs 仓，不随本项目提交）
# ============================================================
/doc/
/shared-docs/
